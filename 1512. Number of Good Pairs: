class Solution {
    public int numIdenticalPairs(int[] nums) {
        int[] count = new int[101];
        int goodPairs = 0;
        
        for (int num : nums) {
            // Every time we see 'num', it can form a pair with all previously seen 'num's
            goodPairs += count[num];
            count[num]++;
        }
        
        return goodPairs;
    }
}
